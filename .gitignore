# ESP-IDF build output (regenerated by `idf.py build`)
build/
**/build/
# per-variant build dirs from run.ps1 (build_root_wormhole_tree, build_victim_wormhole_tree_B, ...)
build_*/
**/build_*/

# sdkconfig backups / generated headers
sdkconfig.old
**/sdkconfig.old

# CLion / CMake
cmake-build-*/
.idea/

# Host-side export output
tools/exports/

# Stray repo-root exports/ — NOT a real output folder. Several tools default
# their output/scan dir to a bare "exports" resolved against the SHELL'S CWD
# (run_matrix.py --outdir, verify_topology.py --dir, validate_integrity.py's
# positional arg), so running one from the repo root instead of tools\ silently
# creates and/or scans .\exports\ here. One such accident got committed
# (exports/blackhole/linear_topology/, commit 8200955). Ignore it so it can
# never be committed again — the real captures live in tools/exports/.
/exports/

# Host-side analysis output (regenerated by run.ps1 -Analyze / the M6-M8 scripts).
# Only the .gitkeep scaffold under analysis/<attack>/<topology>_topology/ is tracked;
# the derived datasets/plots are not.
analysis/**/windowed_dataset.csv
analysis/**/feature_table.csv
analysis/**/eda_output/

# Python
__pycache__/
*.pyc

# OS junk
Thumbs.db
.DS_Store


how to run esp32.txt
